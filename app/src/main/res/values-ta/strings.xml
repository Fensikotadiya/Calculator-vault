    <string name="intro_title">உங்கள் தனிப்பட்ட கால்குலேட்டர்</string>
    <string name="intro_body">6–12 இலக்கப் பின்னை அமைக்கவும். அதைக் கால்குலேட்டரில் உள்ளிட்டு = ஐத் தட்டினால் உங்கள் புகைப்பட, வீடியோப் பெட்டகம் திறக்கும்.\n\nபின்னை மீட்க வழியில்லை. ஆப்ஸை நீக்கினாலோ அதன் தரவை அழித்தாலோ பெட்டகமும் போய்விடும். முக்கியமான கோப்புகளை முதலில் ஏற்றுமதி செய்யுங்கள்.</string>
    <string name="intro_action">பின்னை அமை</string>

    <string name="pin_title">உங்கள் பின்னை உருவாக்கவும்</string>
    <string name="pin_body">6–12 இலக்கங்கள். கால்குலேட்டரில் உள்ளிட்டு = ஐத் தட்டினால் பெட்டகம் திறக்கும். மீட்பு இல்லை.</string>
    <string name="pin_hint">பின் (6–12 இலக்கங்கள்)</string>
    <string name="pin_confirm">பின்னை உறுதிப்படுத்து</string>
    <string name="pin_save">பின்னைச் சேமி</string>
    <string name="pin_mismatch">6–12 இலக்கங்களுள்ள ஒரே பின்னை இருமுறை உள்ளிடவும்</string>
    <string name="pin_saving">சேமிக்கிறது…</string>
    <string name="pin_saved">பின் சேமிக்கப்பட்டது. அதை உள்ளிட்டு = ஐத் தட்டித் திறக்கவும்.</string>
    <string name="pin_failed">பின்னைச் சேமிக்க முடியவில்லை. மீண்டும் முயலவும்.</string>
    <string name="pin_show">பின்னைக் காட்டு</string>
    <string name="pin_hide">பின்னை மறை</string>

