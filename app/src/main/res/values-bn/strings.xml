    <string name="intro_title">আপনার ব্যক্তিগত ক্যালকুলেটর</string>
    <string name="intro_body">৬–১২ সংখ্যার একটি পিন দিন। ক্যালকুলেটরে সেটি লিখে = চাপলে আপনার ছবি ও ভিডিওর ভল্ট খুলবে।\n\nপিন পুনরুদ্ধারের কোনও উপায় নেই। অ্যাপ আনইনস্টল করলে বা এর ডেটা মুছে ফেললে ভল্টও মুছে যায়। গুরুত্বপূর্ণ ফাইল আগে রপ্তানি করে নিন।</string>
    <string name="intro_action">পিন সেট করুন</string>

